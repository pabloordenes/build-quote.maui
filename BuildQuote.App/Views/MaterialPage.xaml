<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewmodels="clr-namespace:BuildQuote.App.ViewModels"
             xmlns:entities="clr-namespace:BuildQuote.Domain.Entities;assembly=BuildQuote.Domain"
             x:Class="BuildQuote.App.Views.MaterialPage"
             x:DataType="viewmodels:MaterialViewModel"
             BackgroundColor="{AppThemeBinding Light=#F4F6F8, Dark=#0F172A}">
    <Grid RowDefinitions="Auto, Auto, *">

        <Label Grid.Row="0" 
               Text="Inventario" 
               FontSize="32" 
               FontAttributes="Bold" 
               Margin="20,25,20,5"
               TextColor="{AppThemeBinding Light=#1E293B, Dark=#F8FAFC}" />

        <Label Grid.Row="1" 
               Text="Gestiona tus materiales y servicios" 
               FontSize="14" 
               Margin="20,0,20,15"
               TextColor="{AppThemeBinding Light=#64748B, Dark=#94A3B8}" />

        <ScrollView Grid.Row="2">
            <VerticalStackLayout Spacing="20" Padding="20,0,20,20">

                <Border StrokeShape="RoundRectangle 12" 
                        StrokeThickness="0"
                        BackgroundColor="{AppThemeBinding Light=White, Dark=#1E293B}">
                    <Border.Shadow>
                        <Shadow Brush="Black" Opacity="{AppThemeBinding Light=0.1, Dark=0.3}" Offset="0,4" Radius="10" />
                    </Border.Shadow>

                    <VerticalStackLayout Spacing="15" Padding="20">
                        <Label Text="Nuevo Ítem" FontAttributes="Bold" FontSize="18" TextColor="{AppThemeBinding Light=#334155, Dark=#E2E8F0}"/>

                        <Entry Placeholder="Ej. Cemento Melón 25kg" 
                               Text="{Binding Name}" 
                               FontSize="16"
                               HeightRequest="45"/>

                        <Grid ColumnDefinitions="*, *" ColumnSpacing="15">
                            <Picker Grid.Column="0" 
                                    Title="Unidad" 
                                    ItemsSource="{Binding Units}" 
                                    SelectedItem="{Binding SelectedUnit}" 
                                    FontSize="16"
                                    HeightRequest="45"/>

                            <Entry Grid.Column="1" 
                                   Placeholder="Costo ($)" 
                                   Text="{Binding UnitCost}" 
                                   Keyboard="Numeric" 
                                   FontSize="16"
                                   HeightRequest="45"/>
                        </Grid>

                        <Button Text="Agregar al Inventario" 
                                Command="{Binding AddMaterialCommand}" 
                                BackgroundColor="#0284C7" 
                                TextColor="White"
                                HeightRequest="50" 
                                CornerRadius="8" 
                                FontSize="16"
                                FontAttributes="Bold"
                                Margin="0,5,0,0"/>
                    </VerticalStackLayout>
                </Border>

                <CollectionView ItemsSource="{Binding Materials}">
                    <CollectionView.ItemsLayout>
                        <LinearItemsLayout Orientation="Vertical" ItemSpacing="12" />
                    </CollectionView.ItemsLayout>

                    <CollectionView.ItemTemplate>
                        <DataTemplate x:DataType="entities:Material">
                            <Border StrokeShape="RoundRectangle 10" 
                                    StrokeThickness="1"
                                    Stroke="{AppThemeBinding Light=#E2E8F0, Dark=#334155}"
                                    BackgroundColor="{AppThemeBinding Light=White, Dark=#0F172A}"
                                    Padding="15">

                                <Grid ColumnDefinitions="*, Auto" RowDefinitions="Auto, Auto">
                                    <Label Grid.Row="0" Grid.Column="0" 
                                           Text="{Binding Name}" 
                                           FontAttributes="Bold" 
                                           FontSize="16"
                                           TextColor="{AppThemeBinding Light=#0F172A, Dark=#F1F5F9}"/>

                                    <Label Grid.Row="1" Grid.Column="0" 
                                           Text="{Binding Unit, StringFormat='Por {0}'}" 
                                           FontSize="13"
                                           TextColor="{AppThemeBinding Light=#64748B, Dark=#94A3B8}"/>

                                    <Label Grid.Row="0" Grid.Column="1" 
                                           Text="{Binding UnitCost, StringFormat='${0:N0}'}" 
                                           FontAttributes="Bold" 
                                           TextColor="#10B981" 
                                           FontSize="16"
                                           VerticalOptions="Center"/>

                                    <Button Grid.Row="1" Grid.Column="1" 
                                            Text="Borrar" 
                                            Command="{Binding Source={RelativeSource AncestorType={x:Type viewmodels:MaterialViewModel}}, Path=DeleteMaterialCommand}"
                                            CommandParameter="{Binding .}"
                                            BackgroundColor="Transparent"
                                            TextColor="#EF4444"
                                            FontSize="12"
                                            Padding="0"
                                            HeightRequest="24"
                                            HorizontalOptions="End"/>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>

            </VerticalStackLayout>
        </ScrollView>
    </Grid>
</ContentPage>