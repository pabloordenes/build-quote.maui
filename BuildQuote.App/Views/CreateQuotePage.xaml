<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewmodels="clr-namespace:BuildQuote.App.ViewModels"
             xmlns:entities="clr-namespace:BuildQuote.Domain.Entities;assembly=BuildQuote.Domain"
             x:Class="BuildQuote.App.Views.CreateQuotePage"
             x:DataType="viewmodels:CreateQuoteViewModel"
             BackgroundColor="{AppThemeBinding Light=#F4F6F8, Dark=#0F172A}">

    <ScrollView>
        <VerticalStackLayout Spacing="15" Padding="20">

            <Border StrokeShape="RoundRectangle 12" StrokeThickness="0" BackgroundColor="{AppThemeBinding Light=White, Dark=#1E293B}">
                <VerticalStackLayout Spacing="10" Padding="15">
                    <Label Text="Cliente y Obra" FontAttributes="Bold" TextColor="{AppThemeBinding Light=#334155, Dark=#E2E8F0}"/>
                    <Entry Placeholder="Nombre del Cliente" Text="{Binding ClientName}" HeightRequest="45"/>
                    <Entry Placeholder="Dirección del Proyecto" Text="{Binding ProjectAddress}" HeightRequest="45"/>
                    <Entry Placeholder="Teléfono" Text="{Binding ClientPhone}" Keyboard="Telephone" HeightRequest="45"/>
                </VerticalStackLayout>
            </Border>

            <Border StrokeShape="RoundRectangle 12" StrokeThickness="0" BackgroundColor="{AppThemeBinding Light=White, Dark=#1E293B}">
                <VerticalStackLayout Spacing="10" Padding="15">
                    <Label Text="Añadir Ítems" FontAttributes="Bold" TextColor="{AppThemeBinding Light=#334155, Dark=#E2E8F0}"/>

                    <Grid ColumnDefinitions="*, 80" ColumnSpacing="10">
                        <Picker Grid.Column="0" 
                                Title="Seleccione material..." 
                                ItemsSource="{Binding AvailableMaterials}" 
                                ItemDisplayBinding="{Binding Name}"
                                SelectedItem="{Binding SelectedMaterial}" 
                                HeightRequest="45"/>

                        <Entry Grid.Column="1" Placeholder="Cant." Text="{Binding Quantity}" Keyboard="Numeric" HeightRequest="45"/>
                    </Grid>

                    <Button Text="Agregar a Cotización" Command="{Binding AddItemCommand}" BackgroundColor="#10B981" TextColor="White" FontAttributes="Bold"/>
                </VerticalStackLayout>
            </Border>

            <VerticalStackLayout BindableLayout.ItemsSource="{Binding Items}" Spacing="10">
                <BindableLayout.ItemTemplate>
                    <DataTemplate x:DataType="entities:QuoteItem">
                        <Border StrokeShape="RoundRectangle 8" StrokeThickness="1" Stroke="#E2E8F0" BackgroundColor="Transparent" Padding="10">
                            <Grid ColumnDefinitions="*, Auto, Auto" ColumnSpacing="15">
                                <VerticalStackLayout Grid.Column="0">
                                    <Label Text="{Binding DescriptionOverride}" FontAttributes="Bold"/>
                                    <Label Text="{Binding UnitPrice, StringFormat='${0:N0} c/u'}" FontSize="12" TextColor="Gray"/>
                                </VerticalStackLayout>
                                <Label Grid.Column="1" Text="{Binding Quantity, StringFormat='x{0}'}" VerticalOptions="Center"/>
                                <Label Grid.Column="2" Text="{Binding TotalPrice, StringFormat='${0:N0}'}" FontAttributes="Bold" TextColor="#0284C7" VerticalOptions="Center"/>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </BindableLayout.ItemTemplate>
            </VerticalStackLayout>

            <Border StrokeShape="RoundRectangle 12" StrokeThickness="0" BackgroundColor="{AppThemeBinding Light=White, Dark=#1E293B}" Margin="0,10,0,20">
                <VerticalStackLayout Spacing="5" Padding="15">
                    <Grid ColumnDefinitions="*, Auto">
                        <Label Grid.Column="0" Text="Subtotal neto:" TextColor="Gray"/>
                        <Label Grid.Column="1" Text="{Binding Subtotal, StringFormat='${0:N0}'}"/>
                    </Grid>
                    <Grid ColumnDefinitions="*, Auto">
                        <Label Grid.Column="0" Text="IVA (19%):" TextColor="Gray"/>
                        <Label Grid.Column="1" Text="{Binding TaxAmount, StringFormat='${0:N0}'}"/>
                    </Grid>
                    <BoxView HeightRequest="1" Color="Gray" Margin="0,5"/>
                    <Grid ColumnDefinitions="*, Auto">
                        <Label Grid.Column="0" Text="TOTAL:" FontAttributes="Bold" FontSize="18" TextColor="{AppThemeBinding Light=#0F172A, Dark=White}"/>
                        <Label Grid.Column="1" Text="{Binding Total, StringFormat='${0:N0}'}" FontAttributes="Bold" FontSize="20" TextColor="#10B981"/>
                    </Grid>

                    <Button Text="GUARDAR PRESUPUESTO" Command="{Binding SaveQuoteCommand}" BackgroundColor="#0284C7" TextColor="White" HeightRequest="55" CornerRadius="8" FontAttributes="Bold" Margin="0,15,0,0"/>
                </VerticalStackLayout>
            </Border>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>